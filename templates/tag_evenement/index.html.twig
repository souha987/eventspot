{% extends 'base.html.twig' %}
{% block title %}Tags{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-tags"></i> Tags</h1>
    <a href="{{ path('app_tag_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouveau tag
    </a>
</div>
<div class="row g-3">
{% for tag in tags %}
    <div class="col-auto">
        <div class="card shadow-sm d-flex flex-row align-items-center p-3 gap-3">
            <span class="badge fs-6" style="background-color:{{ tag.couleur }}">{{ tag.nom }}</span>
            <small class="text-muted">{{ tag.couleur }}</small>
            <form method="post" action="{{ path('app_tag_delete', {id: tag.id}) }}"
                  onsubmit="return confirm('Supprimer ce tag ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
        </div>
    </div>
{% else %}
    <p class="text-muted">Aucun tag.</p>
{% endfor %}
</div>
{% endblock %}