{% extends 'base.html.twig' %}

{% block title %}Tags — EventSpot{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-4">
            <div>
                <h1 class="fw-bold text-uppercase" style="letter-spacing: 2px;">Tags</h1>
                <p class="text-muted mb-0">Catégorisation visuelle des événements.</p>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex gap-2">
                    <a href="{{ path('app_tag_new') }}" class="btn btn-dark">
                        Nouveau Tag
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="row g-3">
        {% for tag in tags %}
            <div class="col-md-4 col-lg-3">
                <div class="card border-dark rounded-0 p-3 h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div style="width: 20px; height: 20px; background-color: {{ tag.couleur }}; border: 1px solid #000;"></div>
                        <span class="fw-bold text-uppercase small">{{ tag.nom }}</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <code class="small text-muted">{{ tag.couleur }}</code>
                        {% if is_granted('ROLE_ADMIN') %}
                        <form method="post" action="{{ path('app_tag_delete', {id: tag.id}) }}" onsubmit="return confirm('Supprimer ce tag ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                            <button class="btn btn-link text-danger p-0"><i class="bi bi-trash"></i></button>
                        </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted text-uppercase small">Aucun tag défini.</p>
            </div>
        {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
