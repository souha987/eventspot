<!DOCTYPE html>
<html lang="fr">
<head>
    {{ importmap('app') }}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EventSpot{% endblock %}</title>
    
    <!-- Bootswatch ZEPHYR Template (Modern & Blue) -->
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/zephyr/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    
    <link rel="icon" href="data:,">
    <style>
        :root {
            --blue-gradient: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
            --nav-bg: #1a1a1a;
        }
        body { 
            background-color: #f8f9fa;
        }
        .gradient-text {
            background: var(--blue-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
        }
        .navbar {
            background-color: var(--nav-bg) !important;
            padding: 1rem 0;
            border-bottom: 3px solid #0d6efd;
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: #fff !important;
        }
        .nav-link {
            font-weight: 600;
            color: rgba(255,255,255,0.8) !important;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        .nav-link:hover {
            color: #0dcaf0 !important;
        }
        /* Style spécifique pour le bouton Événements dans la navbar */
        .nav-btn-frame {
            border: 2px solid #0d6efd;
            border-radius: 10px;
            padding: 0.5rem 1.2rem !important;
            margin: 0 0.5rem;
            background: rgba(13, 110, 253, 0.05);
        }
        .nav-btn-frame:hover {
            background: rgba(13, 110, 253, 0.15);
            border-color: #0dcaf0;
        }
        .btn-primary {
            background: var(--blue-gradient);
            border: none;
            border-radius: 50px;
            padding: 0.7rem 2rem;
            font-weight: 700;
            transition: transform 0.2s;
        }
        .btn-primary:hover {
            transform: scale(1.05);
            background: var(--blue-gradient);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .footer {
            background-color: var(--nav-bg);
            color: #fff;
            padding: 4rem 0 2rem;
            margin-top: 5rem;
        }
        .badge-cat { 
            padding: 0.5rem 0.8rem; 
            border-radius: 6px; 
            font-weight: 700; 
            color: #fff;
            text-transform: uppercase;
            font-size: 0.7rem;
            display: inline-block;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container">
    <a class="navbar-brand" href="{{ path('app_home') }}">
      <i class="bi bi-lightning-charge-fill text-info"></i> EVENT<span class="text-info">SPOT</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item">
          <a class="nav-link px-3" href="{{ path('app_home') }}">Accueil</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3 nav-btn-frame" href="{{ path('app_evenement_index') }}">Événements</a>
        </li>
        {% if is_granted('ROLE_ORGANISATEUR') %}
        <li class="nav-item">
          <a class="nav-link px-3" href="{{ path('app_lieu_index') }}">Lieux</a>
        </li>
        {% endif %}
        {% if is_granted('ROLE_ADMIN') %}
        <li class="nav-item">
          <a class="nav-link px-3" href="{{ path('app_tag_index') }}">Tags</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3" href="{{ path('app_categorie_index') }}">Catégories</a>
        </li>
        {% endif %}
      </ul>
      
      <div class="d-flex align-items-center gap-3">
        {% if app.user %}
            <div class="dropdown">
                <a class="btn btn-primary rounded-pill dropdown-toggle px-4" href="#" role="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-2"></i>{{ app.user.pseudo }}
                </a>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-2">
                    {% if is_granted('ROLE_ORGANISATEUR') %}
                        <li><a class="dropdown-item py-2" href="{{ path('app_evenement_new') }}"><i class="bi bi-plus-circle me-2"></i>Créer</a></li>
                    {% endif %}
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                </ul>
            </div>
        {% else %}
            <a class="nav-link text-white me-2" href="{{ path('app_login') }}">Connexion</a>
            <a class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" href="{{ path('app_register') }}">S'inscrire</a>
        {% endif %}
      </div>
    </div>
  </div>
</nav>

<main>
    <div class="container mt-4">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'danger' ? 'danger' : 'info') }} alert-dismissible fade show border-0 shadow-sm">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    {% block body %}{% endblock %}
</main>

<footer class="footer">
    <div class="container">
        <div class="row g-4 text-center text-md-start">
            <div class="col-lg-6">
                <h4 class="fw-bold mb-3">EVENT<span class="text-info">SPOT</span></h4>
                <p class="text-muted pe-lg-4">La plateforme n°1 pour découvrir les meilleurs événements et conférences à travers le monde.</p>
            </div>
            <div class="col-md-3">
                <h6 class="text-uppercase fw-bold mb-3">Liens Rapides</h6>
                <ul class="list-unstyled">
                    <li><a href="{{ path('app_evenement_index') }}" class="text-muted text-decoration-none small">Tous les événements</a></li>
                    <li><a href="#" class="text-muted text-decoration-none small">À propos</a></li>
                    <li><a href="#" class="text-muted text-decoration-none small">Contact</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="text-uppercase fw-bold mb-3">Suivez-nous</h6>
                <div class="d-flex justify-content-center justify-content-md-start gap-3">
                    <a href="#" class="btn btn-outline-light btn-sm rounded-circle p-2"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="btn btn-outline-light btn-sm rounded-circle p-2"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="btn btn-outline-light btn-sm rounded-circle p-2"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
        </div>
        <hr class="my-5 opacity-10">
        <p class="text-center text-muted small mb-0">&copy; {{ "now"|date("Y") }} EventSpot. Tous droits réservés.</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>




