{% extends 'base.html.twig' %}

{% block title %}Connexion — EventSpot{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="text-center mb-5">
                    <h1 class="fw-bold display-5">Connexion</h1>
                    <p class="text-muted">Heureux de vous revoir sur EventSpot.</p>
                </div>

                <div class="card border-0 shadow-lg rounded-5 p-4 p-md-5 bg-white">
                    {% if error %}
                        <div class="alert alert-danger rounded-4 small mb-4">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Email</label>
                            <input class="form-control border-0 bg-light rounded-4 py-3" type="email" name="_username" value="{{ last_username }}" required autofocus>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Mot de passe</label>
                            <input class="form-control border-0 bg-light rounded-4 py-3" type="password" name="_password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        
                        <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow mb-4" type="submit">
                            Se connecter
                        </button>
                    </form>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            Pas encore de compte ? 
                            <a href="{{ path('app_register') }}" class="text-primary fw-bold text-decoration-none">S'inscrire</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}


