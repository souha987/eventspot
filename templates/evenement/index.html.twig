{% extends 'base.html.twig' %}
{% block title %}Accueil — EventSpot{% endblock %}
{% block body %}
<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">🎉 Prochains événements</h1>
    <p class="text-muted">Découvrez les 6 prochains événements publiés</p>
</div>
<div class="row row-cols-1 row-cols-md-3 g-4">
    {% for e in evenements %}
        {% include 'evenement/_card.html.twig' with {evenement: e} %}
    {% else %}
        <p class="text-center text-muted">Aucun événement à venir.</p>
    {% endfor %}
</div>
{% endblock %}