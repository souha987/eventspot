{% extends 'base.html.twig' %}

{% block title %}EventSpot — Accueil{% endblock %}

{% block body %}
<!-- Hero Section Organisée & Colorée -->
<section class="py-5 bg-white shadow-sm mb-5">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-6 text-center text-lg-start">
                <h1 class="display-3 fw-bold mb-4">Découvrez les meilleurs <span class="text-primary">événements</span></h1>
                <p class="lead text-muted mb-5">Hackathons, conférences, meetups... Trouvez votre prochain défi et rejoignez la communauté.</p>
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                    <a href="{{ path('app_evenement_index') }}" class="btn btn-primary btn-lg rounded-pill px-5 shadow">Événements</a>
                    <a href="{{ path('app_register') }}" class="btn btn-outline-primary btn-lg rounded-pill px-5">S'inscrire</a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <img src="https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=1200&q=80" class="img-fluid rounded-5 shadow-lg" alt="Événement">
            </div>
        </div>
    </div>
</section>

<section class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-star-fill text-warning me-2"></i>Événements à la une</h2>
        <a href="{{ path('app_evenement_index') }}" class="btn btn-link text-decoration-none fw-bold">Voir tous les événements &rarr;</a>
    </div>

    <div class="row g-4">
        {% for e in evenements %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 overflow-hidden">
                    {% if e.imageName %}
                        <div class="position-relative" style="height: 200px;">
                            <img src="{{ asset('uploads/evenements/' ~ e.imageName) }}" class="w-100 h-100" style="object-fit:cover;" alt="{{ e.titre }}">
                        </div>
                    {% endif %}
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            {% for tag in e.tags %}
                                <span class="badge-cat" style="background-color: {{ tag.couleur }};">{{ tag.nom }}</span>
                            {% else %}
                                <span class="badge-cat bg-secondary">{{ e.categorie }}</span>
                            {% endfor %}
                        </div>
                        <h4 class="card-title fw-bold mb-3">{{ e.titre }}</h4>
                        <div class="d-flex flex-column gap-2 text-muted small mb-4">
                            <span><i class="bi bi-geo-alt-fill text-primary me-2"></i>{{ e.lieu ? e.lieu.ville : 'En ligne' }}</span>
                            <span><i class="bi bi-people-fill text-primary me-2"></i>{{ e.inscriptions|length }} participants</span>
                        </div>
                        <a href="{{ path('app_evenement_show', {id: e.id}) }}" class="btn btn-primary w-100 rounded-pill fw-bold">Détails</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted">Aucun événement disponible pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</section>

<section class="bg-primary py-5 text-white text-center rounded-5 mx-3 mb-5 shadow-lg">
    <div class="container">
        <h2 class="display-5 fw-bold mb-4">Vous êtes organisateur ?</h2>
        <p class="lead mb-4">Publiez vos événements et touchez une large communauté de passionnés.</p>
        {% if is_granted('ROLE_ORGANISATEUR') %}
            <a href="{{ path('app_evenement_new') }}" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-primary">Créer un événement</a>
        {% else %}
            <a href="{{ path('app_register') }}" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-primary">Nous rejoindre</a>
        {% endif %}
    </div>
</section>
{% endblock %}



