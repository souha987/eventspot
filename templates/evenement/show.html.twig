{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }} — EventSpot{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_evenement_index') }}">Événements</a></li>
                <li class="breadcrumb-item active">{{ evenement.titre }}</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-lg-8">
                <div class="mb-5">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        {% for tag in evenement.tags %}
                            <span class="badge-cat" style="background-color: {{ tag.couleur }};">{{ tag.nom }}</span>
                        {% else %}
                            <span class="badge-cat bg-secondary">{{ evenement.categorie }}</span>
                        {% endfor %}
                    </div>
                    
                    <h1 class="display-4 fw-bold mb-4">{{ evenement.titre }}</h1>
                    
                    <div class="d-flex flex-wrap gap-4 text-muted mb-5 border-bottom pb-4">
                        <span class="fw-bold"><i class="bi bi-calendar3 text-primary me-2"></i>{{ evenement.dateDebut ? evenement.dateDebut|date('d F Y') : '-' }}</span>
                        <span class="fw-bold"><i class="bi bi-clock text-primary me-2"></i>{{ evenement.dateDebut ? evenement.dateDebut|date('H:i') : '-' }}</span>
                        <span class="fw-bold"><i class="bi bi-geo-alt text-primary me-2"></i>{{ evenement.lieu ? evenement.lieu.ville : 'En ligne' }}</span>
                    </div>

                    {% if evenement.imageName %}
                        <div class="mb-5">
                            <img src="{{ asset('uploads/evenements/' ~ evenement.imageName) }}" class="w-100 rounded-5 shadow-sm border" style="max-height: 450px; object-fit: cover;" alt="{{ evenement.titre }}">
                        </div>
                    {% endif %}

                    <div class="mb-5 bg-white p-4 p-md-5 rounded-5 shadow-sm">
                        <h3 class="fw-bold mb-4">À propos de l'événement</h3>
                        <div class="text-muted fs-5" style="white-space: pre-wrap; line-height: 1.8;">{{ evenement.description }}</div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-5">
                        {% for tag in evenement.tags %}
                            <span class="badge rounded-pill bg-light text-primary border px-3 py-2 fw-bold">#{{ tag.nom }}</span>
                        {% endfor %}
                    </div>

                    {% if is_granted('EVENEMENT_EDIT', evenement) or is_granted('EVENEMENT_DELETE', evenement) %}
                        <div class="p-4 bg-white border-start border-4 border-warning rounded-4 shadow-sm d-flex gap-3 align-items-center">
                            <span class="fw-bold me-auto">Administration de l'événement</span>
                            {% if is_granted('EVENEMENT_EDIT', evenement) %}
                                <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="btn btn-warning rounded-pill px-4 fw-bold">Modifier</a>
                            {% endif %}
                            {% if is_granted('EVENEMENT_DELETE', evenement) %}
                                <form method="post" action="{{ path('app_evenement_delete', {id: evenement.id}) }}" onsubmit="return confirm('Supprimer cet événement ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-bold">Supprimer</button>
                                </form>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-top" style="top: 100px;">
                    <div class="card border-0 shadow-lg rounded-5 overflow-hidden mb-4">
                        <div class="card-body p-4 p-xl-5">
                            <h4 class="fw-bold mb-4">Informations</h4>
                            
                            <div class="d-flex flex-column gap-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3 text-primary">
                                        <i class="bi bi-wallet2 fs-4"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block fw-bold text-uppercase">Prix</small>
                                        <span class="fw-bold fs-5 text-primary">{{ evenement.prix|price_format }}</span>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 p-3 rounded-4 me-3 text-success">
                                        <i class="bi bi-people fs-4"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted d-block fw-bold text-uppercase">Participants</small>
                                        <span class="fw-bold">{{ evenement.inscriptions|length }} / {{ evenement.capaciteMax }}</span>
                                        {% set pct = evenement.capaciteMax > 0 ? (evenement.inscriptions|length / evenement.capaciteMax * 100)|round : 0 %}
                                        <div class="progress mt-2" style="height: 8px; border-radius: 10px;">
                                            <div class="progress-bar rounded-pill {{ pct >= 90 ? 'bg-danger' : (pct >= 70 ? 'bg-warning' : 'bg-success') }}" style="width: {{ pct }}%"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center">
                                    <div class="bg-info bg-opacity-10 p-3 rounded-4 me-3 text-info">
                                        <i class="bi bi-geo-alt fs-4"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block fw-bold text-uppercase">Lieu</small>
                                        <span class="fw-bold">{{ evenement.lieu ? evenement.lieu.nom : 'À définir' }}</span>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-5 opacity-10">

                            {% if evenement.statut == 'annule' %}
                                <div class="alert alert-dark text-center fw-bold mb-0 rounded-4">Événement annulé</div>
                            {% elseif evenement.statut == 'complet' %}
                                <div class="alert alert-danger text-center fw-bold mb-0 rounded-4">Complet</div>
                            {% elseif not is_granted('ROLE_USER') %}
                                <a href="{{ path('app_login') }}" class="btn btn-primary w-100 py-3 rounded-pill fw-bold mb-3 shadow">S'inscrire</a>
                                <p class="text-center small text-muted mb-0">Connexion requise</p>
                            {% elseif dejaInscrit %}
                                <div class="btn btn-outline-success w-100 py-3 rounded-pill fw-bold disabled"><i class="bi bi-check2-circle me-2"></i>Déjà inscrit</div>
                            {% else %}
                                <a href="{{ path('app_evenement_inscription', {id: evenement.id}) }}" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow">S'inscrire maintenant</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}


