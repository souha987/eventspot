{% extends 'base.html.twig' %}
{% block title %}Lieux{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-geo-alt"></i> Lieux</h1>
    <a href="{{ path('app_lieu_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouveau lieu
    </a>
</div>
<div class="table-responsive">
<table class="table table-hover bg-white shadow-sm rounded">
    <thead class="table-dark">
        <tr><th>Nom</th><th>Adresse</th><th>Ville</th><th>Capacité</th></tr>
    </thead>
    <tbody>
    {% for lieu in lieux %}
        <tr>
            <td><strong>{{ lieu.nom }}</strong></td>
            <td>{{ lieu.adresse }}</td>
            <td>{{ lieu.ville }}</td>
            <td>{{ lieu.capacite }}</td>
        </tr>
    {% else %}
        <tr><td colspan="4" class="text-center text-muted py-4">Aucun lieu.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}